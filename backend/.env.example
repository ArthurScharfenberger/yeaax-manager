# Yeaax Manager API (backend mínimo) — variáveis de ambiente.
#
# Cadastre os valores reais SOMENTE nas Environment Variables do projeto na Vercel
# (marcadas como Sensitive). Nunca versione um `.env` com valores reais. Ver backend/README.md.

# TikTok for Developers → app "Yeaax Manager" → Client key (público, vai na URL de autorização).
TIKTOK_CLIENT_KEY=

# TikTok for Developers → Client secret. SEGREDO: existe apenas aqui no backend (DEC-023).
TIKTOK_CLIENT_SECRET=

# Não há variável de redirect: o Login Kit é Desktop (DEC-027) e o redirect é o loopback do próprio app,
# cadastrado no portal como http://127.0.0.1:*/tiktok/callback e validado em src/loopback.ts.

# Opcional. Padrão: user.info.basic,user.info.profile,video.publish,video.upload
TIKTOK_SCOPES=
