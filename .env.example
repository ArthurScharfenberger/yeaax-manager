# Social Manager — variáveis de ambiente (exemplo)
#
# Copie para `.env` somente quando uma integração real for implementada.
# NUNCA versione o `.env` e NUNCA use o prefixo VITE_ em segredos:
# variáveis VITE_* são embutidas no frontend e ficam visíveis no app.
# Segredos serão lidos apenas pelo lado Rust e, em produção, guardados no
# Credential Manager do sistema (ver docs/SECURITY.md).

# OpenAI (geração de legendas) — status: NOT_STARTED
OPENAI_API_KEY=

# TikTok (Content Posting API / Login Kit) — status: MOCK
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=

# Instagram (Instagram Graph API via Meta) — status: MOCK
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
